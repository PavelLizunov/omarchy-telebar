import QtQuick
import QtTest
import QtMultimedia
import "../../app" as App

// Check actual painted pixels, not just audio position or a nonempty videoSink.
// Requires the synthetic round-480.mp4 generated by the documented visual setup.
TestCase {
  id: tests
  name: "VideoFirstPaint"
  width: 900
  height: 760
  visible: true
  when: windowShown
  FixtureApp { id: model }
  Component { id: roundScene; RoundVideoConsumer {} }
  Component { id: inlineScene; App.MediaView { width: implicitWidth; height: implicitHeight } }

  function coloredPixels(item, left, top, right, bottom) {
    var image = grabImage(item), count = 0
    for (var y = top; y < bottom; y += 20) {
      for (var x = left; x < right; x += 20) {
        var c = image.pixel(x, y)
        if (Math.max(c.r, c.g, c.b) - Math.min(c.r, c.g, c.b) > 0.15) count++
      }
    }
    return count
  }

  function test_first_fullscreen_picture() {
    var item = createTemporaryObject(roundScene, tests)
    verify(item !== null)
    tryCompare(item, "ready", true, 5000)
    verify(coloredPixels(item, 320, 200, 580, 500) > 20,
      "Decoded frames must paint on the first fullscreen open")
  }

  function test_fullscreen_continuing_painted_motion_cold_and_reopen() {
    for (var trial = 0; trial < 2; trial++) {
      var item = createTemporaryObject(roundScene, tests)
      tryCompare(item, "ready", true, 5000)
      item.viewer.player.position = 0
      item.viewer.player.play()
      var signatures = {}, started = Date.now(), samples = 0
      for (var frame = 0; frame < 15; frame++) {
        wait(100)
        var image = grabImage(item), signature = ""
        for (var y = 240; y < 480; y += 24) {
          for (var x = 340; x < 580; x += 24) {
            var c = image.pixel(x, y)
            signature += Math.round(c.r * 15) + ":" + Math.round(c.g * 15) + ":" + Math.round(c.b * 15) + ";"
          }
        }
        signatures[signature] = true
        samples++
      }
      var unique = Object.keys(signatures).length, elapsed = Date.now() - started
      console.info("PAINTED_MOTION", JSON.stringify({ trial: trial, unique: unique, samples: samples, elapsedMs: elapsed }))
      verify(unique >= 10, "Continuing painted changes are required, not a single decoded still")
      verify(elapsed < 4000, "An overloaded renderer cannot establish smooth playback")
      item.destroy()
      wait(0)
    }
  }

  function test_first_inline_picture() {
    var path = decodeURIComponent(Qt.resolvedUrl("round-480.mp4").toString().replace("file://", ""))
    var media = createTemporaryObject(inlineScene, tests, {
      app: model,
      message: { id: 701, content: { kind: "videoNote", media: { duration: 4, file: { id: 71, path: path } } } }
    })
    verify(media !== null)
    tryVerify(function () { return media.playback && media.playback.position > 100 }, 5000)
    media.activate()
    tryVerify(function () { return media.playback.position > 100 }, 5000)
    media.playback.pause()
    wait(50)
    verify(coloredPixels(media, 40, 40, 160, 160) > 10,
      "The full-window inline circle must paint on its first audible play")
  }
}
